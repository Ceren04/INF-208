# VeloGuard — Ortam Değişkenleri (Örnek)
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin:
#   cp .env.example .env

# Telegram Bot (BotFather'dan alın)
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=987654321

# Tamper kilidi parolası (SHA-256 hash — plain-text YAZMAYIN)
# python3 -c "import hashlib; print(hashlib.sha256(b'parolaniz').hexdigest())"
TAMPER_PASSWORD_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Web UI gizli anahtarı (Flask session için)
FLASK_SECRET_KEY=cok-gizli-bir-anahtar-degistirin

# Loglama seviyesi (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
